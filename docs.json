{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "FlyHub Wiki",
  "description": "User guides, troubleshooting, and simulator setup for FlyHub pilots.",
  "seo": {
    "metatags": {
      "canonical": "https://docs.flyhub.app"
    }
  },
  "colors": {
    "primary": "#006FD6",
    "light": "#006FD6",
    "dark": "#67B7F7"
  },
  "appearance": {
    "default": "system"
  },
  "logo": {
    "light": "/logo-light-full.svg",
    "dark": "/logo-dark-full.svg",
    "href": "https://flyhub.app"
  },
  "favicon": "/favicon.png",
  "icons": {
    "library": "lucide"
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "FlyHub",
        "href": "https://flyhub.app"
      }
    ]
  },
